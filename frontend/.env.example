# Copy to `.env` and adjust for your machine.
# Leave VITE_API_BASE_URL EMPTY to use the Vite dev proxy (single origin, no CORS needed).
VITE_API_BASE_URL=http://localhost:8000
# Leave empty to derive from VITE_API_BASE_URL (http -> ws automatically).
VITE_WS_BASE_URL=

# Production (Vercel) - Set these in Vercel dashboard under Environment Variables
# VITE_API_BASE_URL=https://health-monitoring-system-g6zq.onrender.com
# VITE_WS_BASE_URL=wss://health-monitoring-system-g6zq.onrender.com
